{
  "scripts": {
    "build": "mkdir -p dist && esbuild src/app.ts --bundle --format=iife --outfile=dist/app.js --target=es2020 && cp index.html style.css dist/",
    "lint": "eslint 'src/**/*.ts' && tsc --noEmit",
    "fmt": "prettier --write 'src/**/*.ts'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@10": "11.0.4"
  }
}
