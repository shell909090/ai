# opencode serve 凭据（Basic Auth）
# 由 opencode serve 通过 OPENCODE_SERVER_USERNAME / OPENCODE_SERVER_PASSWORD 读取
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# Trello 凭据
#
# 首次接入需要走一次 OAuth 1.0a 握手，参考 docs/design.md §3 的"Power-Up 模式接入"
# 流程：拿 Power-Up 的 consumer_key/consumer_secret → 调 OAuthGetRequestToken →
# 浏览器点 OAuthAuthorizeToken → Trello 回调带 verifier → 调 OAuthGetAccessToken
# 换 access_token。授权 URL 里带 expiration=never，token 不会自动过期。
#
# 拿到的值：
TRELLO_API_KEY=            # Power-Up consumer_key (32 字符)
TRELLO_TOKEN=              # OAuth access_token (64+ 字符，ATTA 前缀)
TRELLO_TOKEN_SECRET=       # access_token_secret (32 字符，仅 OAuth 1.0a HMAC 签名用)
